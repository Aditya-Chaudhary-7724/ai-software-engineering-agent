# Application
# "production" additionally: disables /docs, /redoc, /openapi.json on
# the Phase 15 API (backend/api/main.py), and switches logging to
# structured JSON (backend/observability/logging_config.py).
APP_ENV=development

# Phase 15: comma-separated list of exact origins allowed to call the
# API from a browser (CORS). Empty by default — no frontend exists yet
# (see docs/deployment.md) — meaning no CORS headers are sent at all,
# the safest default. Set this to your deployed frontend's real origin
# when one exists; never use "*" in production.
#   ALLOWED_ORIGINS=https://your-frontend.example.com
ALLOWED_ORIGINS=

# LLM (required for Phase 7 agent reasoning; not required for Phases 1-3)
LLM_API_KEY=

# Embeddings (required for real semantic search via OpenAIEmbeddingProvider;
# Phase 3 also works without this using DeterministicLocalEmbeddingProvider,
# a non-semantic local stand-in used for tests/local dev only)
EMBEDDING_API_KEY=

# PostgreSQL + pgvector
# Local dev example (Homebrew Postgres, trust-auth for your OS user,
# dedicated database — do not reuse a database from another project):
#   DATABASE_URL=postgresql://<your-username>@localhost:5432/ai_swe_agent
DATABASE_URL=

# Neo4j (Phase 5)
# Local dev example (Docker container, see docs/architecture.md):
#   NEO4J_URI=bolt://localhost:7687
#   NEO4J_USERNAME=neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# GitHub (Phase 11). Optional for read-only operations against public
# repositories (metadata retrieval, cloning) — required only to read a
# private repository, push a branch, or create a pull request. A
# fine-grained personal access token scoped to just the repositories you
# intend to use this with is recommended over a classic token with
# broader access. Never committed, printed, or passed to the Phase 10
# Docker sandbox — see docs/architecture.md's "GitHub Integration" section.
GITHUB_TOKEN=

# LangSmith (Phase 13). Fully optional — the local JSONFileRecorder
# tracing path (backend/scripts/inspect_trace.py) works completely
# without it. Only needed to additionally export traces to a hosted
# LangSmith project via observability/exporters/langsmith_exporter.py,
# which is never constructed by default anywhere in this codebase.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
