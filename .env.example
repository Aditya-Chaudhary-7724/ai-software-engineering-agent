# Application
# "production" additionally: disables /docs, /redoc, /openapi.json on
# the Phase 15 API (backend/api/main.py), and switches logging to
# structured JSON (backend/observability/logging_config.py).
APP_ENV=development

# Phase 15: comma-separated list of exact origins allowed to call the
# API from a browser (CORS). Empty by default — meaning no CORS headers
# are sent at all, the safest default. The Engineering Lab frontend does
# NOT need this: it is a backend-for-frontend whose SERVER calls this API
# with API_SERVICE_TOKEN, so the browser never calls the API directly.
# Only set it for a different, browser-side client; never use "*".
#   ALLOWED_ORIGINS=https://your-frontend.example.com
ALLOWED_ORIGINS=

# Frontend phase F1: bearer token for the authenticated /api/v1 routes
# (backend/api/auth.py). Only the frontend's SERVER process holds it —
# never a NEXT_PUBLIC_* / browser-visible variable. Minimum 32
# characters; /api/v1 fails closed (503) if unset or shorter. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_SERVICE_TOKEN=

# Frontend phase F3: repository ingestion jobs. Absolute path of a
# DEDICATED directory GitHub repositories are cloned into (the server
# creates <owner>/<repo> under it; the browser never chooses a path).
# Ingestion over HTTP and the in-process job worker are disabled without
# it. Run backend/scripts/apply_schema.py once to create the jobs table.
# Example (gitignored location inside this repo):
#   WORKSPACE_ROOT=/absolute/path/to/ai-software-engineering-agent/data/workspaces
WORKSPACE_ROOT=
# Optional: refuse repositories GitHub reports as larger than this (KB;
# default 250000). INGESTION_WORKER_ENABLED=false keeps the worker off.
INGESTION_MAX_REPOSITORY_KB=
INGESTION_WORKER_ENABLED=

# Frontend phase F6: agent tasks and human approval. The in-process agent
# worker starts whenever DATABASE_URL is set; AGENT_WORKER_ENABLED=false
# keeps it off (task submission and decisions then return 503).
# AGENT_APPROVAL_TTL_SECONDS: how long a proposed change may wait for a
# decision before it expires (positive integer; default 3600).
AGENT_WORKER_ENABLED=
AGENT_APPROVAL_TTL_SECONDS=

# Frontend phase F7 (evaluation only, never used by the API): a SEPARATE,
# disposable database, the default for run_evaluation.py
# --isolated-database-url. When set, ALL evaluation data is written there
# (never to DATABASE_URL); unreachable, or the same database as
# DATABASE_URL, makes the CLI exit 2. See docs/evaluation.md.
#   EVALUATION_DATABASE_URL=postgresql://<your-username>@localhost:5432/ai_swe_agent_test
EVALUATION_DATABASE_URL=

# LLM (required for Phase 7 agent reasoning; not required for Phases 1-3)
LLM_API_KEY=

# Embeddings (required for real semantic search via OpenAIEmbeddingProvider;
# Phase 3 also works without this using DeterministicLocalEmbeddingProvider,
# a non-semantic local stand-in used for tests/local dev only)
EMBEDDING_API_KEY=

# PostgreSQL + pgvector
# Local dev example (Homebrew Postgres, trust-auth for your OS user,
# dedicated database — do not reuse a database from another project):
#   DATABASE_URL=postgresql://<your-username>@localhost:5432/ai_swe_agent
DATABASE_URL=

# Neo4j (Phase 5)
# Local dev example (Docker container, see docs/architecture.md):
#   NEO4J_URI=bolt://localhost:7687
#   NEO4J_USERNAME=neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# GitHub (Phase 11). Optional for read-only operations against public
# repositories (metadata retrieval, cloning) — required only to read a
# private repository, push a branch, or create a pull request. A
# fine-grained personal access token scoped to just the repositories you
# intend to use this with is recommended over a classic token with
# broader access. Never committed, printed, or passed to the Phase 10
# Docker sandbox — see docs/architecture.md's "GitHub Integration" section.
GITHUB_TOKEN=

# LangSmith (Phase 13). Fully optional — the local JSONFileRecorder
# tracing path (backend/scripts/inspect_trace.py) works completely
# without it. Only needed to additionally export traces to a hosted
# LangSmith project via observability/exporters/langsmith_exporter.py,
# which is never constructed by default anywhere in this codebase.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
