# Production environment for deploy/docker-compose.prod.yml. TEMPLATE ONLY:
# no real value belongs in this file or anywhere in the repository.
#
# The real file lives OUTSIDE the repository, on the operator's machine:
#   ~/.config/ai-swe-agent/prod.env   (chmod 600)
# deploy/make-prod-env.sh creates it with every random secret generated, and
# --check reports what is still missing (names only, never values). It is
# copied to the VM over SSH (scp) next to the deploy scripts.
#
# Rules: KEY=value, one per line, no quotes needed, no `$` in values (docker
# compose would interpolate it). Each container receives ONLY the variables
# docker-compose.prod.yml lists for it.

# --- Public address ---------------------------------------------------------
# The DuckDNS hostname, e.g. myname.duckdns.org (Caddy gets its certificate).
SITE_ADDRESS=
# DuckDNS (host-only, used by duckdns.sh; never passed to a container).
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- Images -----------------------------------------------------------------
# GHCR namespace the CD workflow pushes to (lower case).
IMAGE_REGISTRY=ghcr.io/aditya-chaudhary-7724

# --- Generated secrets (make-prod-env.sh) -----------------------------------
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
API_SERVICE_TOKEN=
SESSION_SECRET=

# --- Operator login ---------------------------------------------------------
# cd frontend && npm run -s hash-password   (prompts for the password)
OPERATOR_PASSWORD_HASH=

# --- Groq (free tier) -------------------------------------------------------
GROQ_API_KEY=
# Exact model ids from the Groq console. They must differ (Groq limits are
# per model, so demo traffic can never use up the operator's quota).
LLM_MODEL=
DEMO_LLM_MODEL=
LLM_REASONING_EFFORT=
DEMO_LLM_REASONING_EFFORT=
LLM_MAX_COMPLETION_TOKENS=

# --- Public demo --------------------------------------------------------------
# OFF until both are set: make-prod-env.sh --enable-demo <ids>, with the ids
# seed_demo.py prints after the first deploy (it also generates the token).
DEMO_REPOSITORY_IDS=
DEMO_API_SERVICE_TOKEN=
# Limits (empty = the backend defaults; see .env.example). Size the daily
# budget below DEMO_LLM_MODEL's tokens-per-day limit on the Groq console.
DEMO_ASK_PER_IP_PER_HOUR=
DEMO_ASK_GLOBAL_PER_MINUTE=
DEMO_DAILY_TOKEN_BUDGET=
DEMO_ASK_TOKEN_RESERVE=
DEMO_TASKS_PER_DAY=
DEMO_TASKS_PER_IP_PER_DAY=
DEMO_TASK_TOKEN_RESERVE=
DEMO_TASK_MAX_TOKENS=

# --- Backups (optional, recommended) ------------------------------------------
# Oracle Object Storage pre-authenticated request URL (write-only, ends in /),
# host-only, used by backup.sh. Empty = dumps stay on the VM only.
OFFSITE_BACKUP_PAR_URL=
