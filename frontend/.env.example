# Engineering Lab frontend — SERVER-ONLY configuration.
#
# Copy to .env.local (gitignored) for local development. In production, set
# these in the hosting platform's secret manager instead of a file.
#
# None of these may ever be renamed with a NEXT_PUBLIC_ prefix: that would
# inline the value into JavaScript sent to every browser. There are no
# defaults — authentication fails closed until all required values are set.

# --- Operator login (required) -------------------------------------------
# Argon2id hash of the operator password, base64url-wrapped (Next.js would
# otherwise mangle the "$" characters in a raw PHC string). Generate with:
#   npm run hash-password
OPERATOR_PASSWORD_HASH=

# Signs session cookies and derives CSRF tokens. >= 32 characters of real
# randomness. Rotating it signs every operator out. Generate with:
#   npm run generate-secret
SESSION_SECRET=

# Absolute session lifetime in seconds (optional; default 28800 = 8 h;
# allowed 300 .. 604800).
SESSION_MAX_AGE_SECONDS=

# Public origin of this app, e.g. https://lab.example.com. REQUIRED when
# NODE_ENV=production (CSRF origin checks; rejects DNS-rebinding Host
# headers). Optional in development, where the browser's Host is used.
APP_ORIGIN=

# Set to "true" ONLY behind a reverse proxy that overwrites
# X-Forwarded-For; otherwise clients could forge their rate-limit identity.
TRUST_PROXY_HEADERS=

# --- Backend API (required for data) -------------------------------------
# Base URL of the FastAPI backend as reachable from THIS server (never
# from the browser — the browser only talks to this Next.js app).
BACKEND_URL=http://127.0.0.1:8000

# Must equal the backend's API_SERVICE_TOKEN. Sent only server-to-server.
API_SERVICE_TOKEN=
